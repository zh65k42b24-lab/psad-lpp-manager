# Authentification NextAuth
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Base de données (PostgreSQL recommandée)
DATABASE_URL=postgresql://user:password@localhost:5432/psad_lpp

# API externe (optionnel)
# API_CPAM_KEY=your-cpam-api-key
# API_CPAM_URL=https://api.cpam.fr

# Email (pour notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# URL publique (pour production)
# NEXT_PUBLIC_APP_URL=https://psad-lpp.vercel.app

# Mode développement
NODE_ENV=development
